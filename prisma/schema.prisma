// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  RECEPTIONIST
  MEMBER
}

enum UnitType {
  COWORKING
  BTS
}

enum SpaceType {
  MEETING_ROOM
  PRIVATE_OFFICE
  WORKSTATION
}

enum SpaceStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ServiceOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  DONE
  REJECTED
  CANCELLED
}

enum ServiceType {
  CLEANING
  ELECTRICAL
  HYDRAULIC
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProviderType {
  RECURRING
  PUNCTUAL
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Unit {
  id        String   @id @default(cuid())
  name      String
  type      UnitType
  createdAt DateTime @default(now())

  userUnits     UserUnit[]
  spaces        Space[]
  tickets       Ticket[]
  serviceOrders ServiceOrder[]
  providers     Provider[]

  @@map("units")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userUnits             UserUnit[]
  bookings              Booking[]
  ticketsCreated        Ticket[]       @relation("TicketCreatedBy")
  serviceOrdersCreated  ServiceOrder[] @relation("ServiceOrderCreatedBy")
  serviceOrdersApproved ServiceOrder[] @relation("ServiceOrderApprovedBy")

  // NextAuth v5
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model UserUnit {
  id     String @id @default(cuid())
  userId String
  unitId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
  @@index([unitId])
  @@map("user_units")
}

model Space {
  id          String      @id @default(cuid())
  unitId      String
  name        String
  description String?
  capacity    Int
  type        SpaceType
  status      SpaceStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  unit          Unit           @relation(fields: [unitId], references: [id])
  bookings      Booking[]
  serviceOrders ServiceOrder[]

  @@index([unitId])
  @@map("spaces")
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  spaceId   String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])

  // Índice composto para queries de detecção de conflito de horário
  @@index([spaceId, startTime, endTime])
  @@index([userId])
  @@map("bookings")
}

model Ticket {
  id               String       @id @default(cuid())
  number           String       @unique // TK-2026-0001
  externalTicketId String?               // número no sistema do cliente (ex: TICK-2026-0847)
  unitId           String
  description      String
  priority         Priority
  status           TicketStatus @default(OPEN)
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  unit          Unit           @relation(fields: [unitId], references: [id])
  createdBy     User           @relation("TicketCreatedBy", fields: [createdById], references: [id])
  serviceOrders ServiceOrder[]

  @@index([unitId])
  @@index([createdById])
  @@index([status])
  @@map("tickets")
}

model ServiceOrder {
  id            String             @id @default(cuid())
  number        String             @unique // OS-2026-0001
  ticketId      String
  unitId        String             // herdado do ticket — mantido para queries eficientes por unidade
  spaceId       String?            // opcional — OS do coworking pode ter espaço afetado
  createdById   String
  providerId    String?            // opcional — pode ser definido após aprovação
  approvedById  String?
  serviceType   ServiceType
  description   String
  status        ServiceOrderStatus @default(DRAFT)
  scheduledDate DateTime?
  value         Decimal?
  photos        String[]           @default([])
  approvedAt    DateTime?
  slaDeadline   DateTime?          // calculado na aprovação usando ticket.priority
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  ticket     Ticket    @relation(fields: [ticketId], references: [id])
  unit       Unit      @relation(fields: [unitId], references: [id])
  space      Space?    @relation(fields: [spaceId], references: [id])
  createdBy  User      @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id])
  provider   Provider? @relation(fields: [providerId], references: [id])
  approvedBy User?     @relation("ServiceOrderApprovedBy", fields: [approvedById], references: [id])

  @@index([ticketId])
  @@index([unitId])
  @@index([createdById])
  @@index([status])
  @@map("service_orders")
}

model Provider {
  id        String         @id @default(cuid())
  unitId    String
  name      String
  specialty ServiceType
  phone     String?
  email     String?
  type      ProviderType
  status    ProviderStatus @default(ACTIVE)
  createdAt DateTime       @default(now())

  unit          Unit           @relation(fields: [unitId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([unitId])
  @@map("providers")
}

// ---------------------------------------------------------------------------
// NextAuth v5 — modelos obrigatórios
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
